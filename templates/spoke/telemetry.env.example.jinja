# The telemetry settings for this host's .env, rendered by the CML overlay
# (.copier-answers.cml.yml). Copy them into .env and fill in OTLP_AUTH_TOKEN there:
# no secret belongs in this file.
{%- if contact %}
# Questions about this spoke's telemetry: {{ contact }}
{%- endif %}
PROJECT={{ project }}
ENVIRONMENT={{ env }}
OTEL_EXPORTER_OTLP_ENDPOINT={{ otlp_endpoint }}
# The hub's shared ingest token, from the monitoring operator.
OTLP_AUTH_TOKEN=
# Only if the project's egress crosses a Cloudflare WAF.
TELEMETRY_EDGE_KEY=
# 1 on a host with an NVIDIA card: deploy tooling reads it to include compose.telemetry.gpu.yml.
GPU_METRICS={{ '1' if gpu else '' }}
# bootstrap.sh prints the watchdog's ping URL; run_scheduled.sh reads PING_<JOB>.
PING_WATCHDOG=
