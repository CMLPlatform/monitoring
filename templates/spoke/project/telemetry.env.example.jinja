# This project's telemetry settings for its .env, rendered by the CML project overlay
# (.copier-answers.cml.yml). Copy them into .env and fill in OTLP_AUTH_TOKEN there:
# no secret belongs in this file. The machine's agent has its own settings
# (telemetry-host.env.example, in the repo that owns the machine).
{%- if contact %}
# Questions about this project's telemetry: {{ contact }}
{%- endif %}
PROJECT={{ project }}
ENVIRONMENT={{ env }}
# The app's OpenTelemetry SDK sends straight to the hub (docs/ONBOARDING.md in
# CMLPlatform/monitoring), with the token as OTEL_EXPORTER_OTLP_HEADERS.
OTEL_EXPORTER_OTLP_ENDPOINT={{ otlp_endpoint }}
OTEL_RESOURCE_ATTRIBUTES=project={{ project }},env={{ env }}
# The hub's shared ingest token, from the monitoring operator.
OTLP_AUTH_TOKEN=
# bootstrap.sh prints the watchdog's ping URL; run_scheduled.sh reads PING_<JOB>.
PING_WATCHDOG=
