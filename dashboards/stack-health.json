{
  "title": "Stack Health",
  "uid": "stack-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "graphTooltip": 1,
  "tags": [
    "cml",
    "infra"
  ],
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "cml"
      ],
      "targetBlank": false,
      "title": "CML Dashboards",
      "tooltip": "Switch to another dashboard in the CML monitoring stack",
      "type": "dashboards",
      "url": ""
    },
    {
      "title": "Incident runbook",
      "type": "link",
      "icon": "book",
      "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Incident workflow",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Check scrape status and alerts. Open a project below. Confirm fresh telemetry and resolved alerts; missing data means unknown."
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Scrape Status",
      "description": "Current Prometheus scrape results, not application availability. A disappeared target has no value; consult Active Alerts and the runbook before declaring recovery.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up",
          "instant": true,
          "legendFormat": "{{job}} / {{instance}}",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Job"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Job",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "env": true,
              "project": true,
              "tier": true
            },
            "indexByName": {
              "Value": 0,
              "job": 1,
              "instance": 2
            },
            "renameByName": {
              "job": "Job",
              "instance": "Target",
              "Value": "Status"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Filesystem Used",
      "description": "Loki and Tempo have no total-size cap \u2014 the HostDiskSpaceLow alert fires at 80%.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|overlay\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|ramfs|overlay\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host CPU",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Memory Used",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Collector Ingest Rate",
      "description": "Items accepted by the OTLP receivers, per signal.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans[$__rate_interval]))",
          "legendFormat": "spans/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[$__rate_interval]))",
          "legendFormat": "metric points/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[$__rate_interval]))",
          "legendFormat": "log records/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Collector Export Failures",
      "description": "Anything above zero means a backend is rejecting or unreachable \u2014 the OtelExportFailures alert covers this.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[$__rate_interval]))",
          "legendFormat": "{{exporter}} spans/s (solid)",
          "refId": "A"
        },
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_metric_points[$__rate_interval]))",
          "legendFormat": "{{exporter}} metric points/s (dashed)",
          "refId": "B"
        },
        {
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_log_records[$__rate_interval]))",
          "legendFormat": "{{exporter}} log records/s (dotted)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    0,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest by Project",
      "description": "Accepted telemetry by project and environment. Click a series to open its metrics or logs with the same time range. Missing or zero ingest does not prove a project is healthy.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (project, env) (rate(telemetry_datapoints_total[$__rate_interval]))",
          "legendFormat": "{{project}}/{{env}} metric points/s",
          "refId": "A"
        },
        {
          "expr": "sum by (project, env) (rate(telemetry_logs_total[$__rate_interval]))",
          "legendFormat": "{{project}}/{{env}} log records/s",
          "refId": "B"
        },
        {
          "expr": "sum by (project, env) (rate(telemetry_spans_total[$__rate_interval]))",
          "legendFormat": "{{project}}/{{env}} spans/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "links": [
            {
              "title": "Service metrics",
              "url": "/d/service-health/service-health?var-project=${__field.labels.project:percentencode}&var-env=${__field.labels.env:percentencode}&${__url_time_range}",
              "targetBlank": false
            },
            {
              "title": "Service logs",
              "url": "/d/logs/logs?var-project=${__field.labels.project:percentencode}&var-env=${__field.labels.env:percentencode}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "alertlist",
      "title": "Active Alerts",
      "id": 6,
      "description": "Firing, pending, no-data and query-error states. An empty list alone does not prove the stack is healthy; check scrape status and data freshness.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "alertInstanceLabelFilter": "{alertname!=\"Watchdog\"}",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": false,
          "error": true
        }
      },
      "links": [
        {
          "title": "Runbook",
          "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
          "targetBlank": true
        }
      ]
    }
  ]
}
