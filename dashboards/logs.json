{
  "uid": "logs",
  "title": "Logs",
  "tags": [
    "cml",
    "logs",
    "project"
  ],
  "links": [
    {
      "title": "Service metrics",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/service-health/service-health",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "cml"
      ],
      "targetBlank": false,
      "title": "CML Dashboards",
      "tooltip": "Switch to another dashboard in the CML monitoring stack",
      "type": "dashboards",
      "url": ""
    },
    {
      "title": "Incident runbook",
      "type": "link",
      "icon": "book",
      "url": "https://github.com/CMLPlatform/monitoring/blob/main/docs/RUNBOOK.md#incident-workflow",
      "targetBlank": true
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "editable": null,
  "description": "Every project's container logs. Scoped by the project/env template variables, so a new project appears here the moment its first log line lands \u2014 nobody edits this JSON to onboard one.",
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(project)",
        "query": "label_values(project)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({project=\"$project\"}, env)",
        "query": "label_values({project=\"$project\"}, env)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({project=\"$project\", env=\"$env\"}, service_name)",
        "query": "label_values({project=\"$project\", env=\"$env\"}, service_name)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "includeAll": true,
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Incident workflow",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Compare errors with All Logs. Follow trace IDs into Tempo. Confirm recovery with fresh Service metrics; missing logs do not prove health."
      }
    },
    {
      "type": "timeseries",
      "title": "Log Rate by Service",
      "description": "Which services are talking, and how much.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (service_name) (rate({project=\"$project\", env=\"$env\", service_name=~\"${service:regex}\"}[$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Log Rate by Level",
      "description": "Rate by Loki-detected level. Missing levels or an empty result are not proof that errors stopped; compare All Logs and service metrics.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (detected_level) (rate({project=\"$project\", env=\"$env\", service_name=~\"${service:regex}\"}[$__auto]))",
          "legendFormat": "{{detected_level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Errors & Warnings",
      "description": "Level is detected by Loki at ingest. Expand any log line with a trace_id to jump directly to the trace in Tempo.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{project=\"$project\", env=\"$env\", service_name=~\"${service:regex}\"} | detected_level=~\"(?i)(error|critical|fatal|warn)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "All Logs",
      "description": "Everything, newest first. Expand any line to follow trace_id into Tempo.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{project=\"$project\", env=\"$env\", service_name=~\"${service:regex}\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
